{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$room": {
        ".validate": "$room.matches(/^[23456789bcdfghjkmnpqrstvwxz]{14}$/)",

        "phones": {
          ".read": "auth != null && $room.matches(/^[23456789bcdfghjkmnpqrstvwxz]{14}$/)",

          "$phone": {
            ".write": "auth != null && $phone === auth.uid && $room.matches(/^[23456789bcdfghjkmnpqrstvwxz]{14}$/)",
            ".validate": "!newData.exists() || newData.hasChildren(['m','t'])",

            "h": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 360" },
            "m": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 90" },
            "t": { ".validate": "newData.isNumber() && newData.val() <= now + 5000" },

            "$other": { ".validate": false }
          }
        },

        "tally": {
          ".read": "auth != null && $room.matches(/^[23456789bcdfghjkmnpqrstvwxz]{14}$/)",
          ".write": "auth != null && $room.matches(/^[23456789bcdfghjkmnpqrstvwxz]{14}$/)",
          ".validate": "newData.hasChildren(['c','n','t'])",

          "c": { ".validate": "newData.hasChildren()" },
          "n": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "t": { ".validate": "newData.isNumber() && newData.val() <= now + 5000" },

          "$other": { ".validate": false }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
