# Supabase project: publishable key only. RLS gives it SELECT and nothing else.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Long random string, also stored in private.host_config. Authorises the
# host_freeze / host_reset / host_set_options RPCs. Server-side only.
HOST_DB_SECRET=

# Short code you type on /host. Server-side only.
HOST_PASSCODE=
