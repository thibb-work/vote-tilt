# Firebase web config. Public by design -- the RTDB rules, not these values,
# are what stop a phone writing where it should not.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://<project>-default-rtdb.<region>.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Service account JSON on one line, from Firebase console -> Project settings ->
# Service accounts -> Generate new private key. Writes the session node past the
# rules, which refuse every client write. Server-side only -- this is the whole
# database, so it must never pick up a NEXT_PUBLIC_ prefix.
FIREBASE_SERVICE_ACCOUNT=

# Long random string. Salts the host cookie so it survives redeploys without a
# session store. Server-side only.
HOST_TOKEN_SECRET=

# Short code you type on /host. Server-side only.
HOST_PASSCODE=
